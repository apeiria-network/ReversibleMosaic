# Force LF line endings for files consumed by Unix tools (bash, python, cython).
# Without this, Windows-side edits + git core.autocrlf=true silently rewrite
# these files with CRLF on checkout, which breaks:
#   * bash: `set -euo pipefail\r` → "invalid option name"
#   * shebang lookup: `#!/usr/bin/env bash\r` → "no such file" errno
#   * .pyx: Cython 3.x parser rejects CR in source
# This policy prevents CRLF checkout failures in Bash, shebangs, and Cython.

# Shell scripts
*.sh                text eol=lf

# Python source
*.py                text eol=lf
*.pyx               text eol=lf
*.pxd               text eol=lf

# Config that Unix tools read directly
buildozer.spec      text eol=lf
*.toml              text eol=lf
requirements*.lock  text eol=lf
requirements*.txt   text eol=lf

# Windows-authored / mixed-content docs stay auto (git decides).
# Binary artifacts explicit:
*.png binary
*.jpg binary
*.jpeg binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.so binary
*.pyd binary
